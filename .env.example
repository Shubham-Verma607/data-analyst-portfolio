# Portfolio Environment Configuration Template
# Copy this file to .env for local development

PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUESTS_PER_MINUTE=15

